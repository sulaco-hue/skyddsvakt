      "text": "Från AQ, förbindelsen provas, kom."
    },
    {
      "tid": "18:30",
      "fran": "Grindposten",
      "text": "Hörbarhet femma, kom."
    },
    {
      "tid": "18:30",
      "fran": "AQ",
      "text": "Hörbarhet femma, klart slut."
    }
  ],
  "dialog": {
    "start": {
      "replik": "– Vadå? Jag fotograferar bara höstlöven. Det är väl ändå inte förbjudet att stå på en skogsväg?",
      "alternativ": [
        {
          "text": "Förklara lugnt att området är skyddsobjekt och att skylten anger avbildningsförbud.",
          "handling": "upplysa_forbud",
          "stamning": -1,
          "nasta": "upplyst"
        },
        {
          "text": "Fråga om han frivilligt kan visa bilderna han har tagit.",
          "handling": "fraga_frivilligt",
          "stamning": 1,
          "nasta": "visar"
        },
        {
          "text": "Begär att han uppger namn, födelsetid och hemvist.",
          "handling": "begara_identitet",
          "stamning": 1,
          "nasta": "id_fraga"
        },
        {
          "text": "”Ge mig kameran. Nu.”",
          "handling": "beslag",
          "stamning": 3,
          "nasta": "vagrar"
        },
        {
          "text": "Avsluta kontakten, notera bilens registreringsnummer och rapportera.",
          "handling": "dokumentera",
          "nasta": "lamnar",
          "npc_beteende": "ga_till_start"
        }
      ]
    },
    "upplyst": {
      "replik": "– Okej, okej. Det såg jag inte. Men jag har redan tagit några bilder – vad händer nu?",
      "alternativ": [
        {
          "text": "Fråga om han frivilligt kan visa bilderna.",
          "handling": "fraga_frivilligt",
          "nasta": "visar"
        },
        {
          "text": "Säg att du tar kameran i beslag.",
          "handling": "beslag",
          "stamning": 2,
          "nasta": "vagrar"
        },
        {
          "text": "Tacka för samarbetet, notera registreringsnumret och rapportera.",
          "handling": "dokumentera",
          "stamning": -1,
          "nasta": "lamnar_lugn",
          "npc_beteende": "ga_till_start"
        }
      ]
    },
    "visar": {
      "replik": "– Här. Lite träd… och ja, staketet och huset syns på några. Nöjd nu?",
      "alternativ": [
        {
          "text": "Anropa AQ, rapportera och begär order.",
          "handling": "rapportera_vaktchef",
          "nasta": "vaktchef"
        },
        {
          "text": "Ta kameran i beslag.",
          "handling": "beslag",
          "stamning": 2,
          "nasta": "vagrar"
        },
        {
          "text": "Notera registreringsnumret, tacka och låt honom gå.",
          "handling": "dokumentera",
          "nasta": "lamnar_lugn",
          "npc_beteende": "ga_till_start"
        }
      ]
    },
    "vaktchef": {
      "replik": "DU (radio): ”AQ, AQ.” – AQ: ”AQ kom.”\nDU: ”Från Grindposten, person invid objektet har fotograferat det, begär order, kom.”\nAQ: ”Uppfattat. Polis underrättas. Notera hans uppgifter om han medger det, slut kom.” – DU: ”Klart slut.”\n\nMANNEN: – Visst, här är mitt körkort.",
      "satt_fakta": {
        "anmalan_polis": true
      },
      "alternativ": [
        {
          "text": "Notera uppgifterna och tacka för samarbetet.",
          "handling": "dokumentera",
          "stamning": -2,
          "nasta": "lamnar_lugn",
          "npc_beteende": "ga_till_start"
        }
      ]
    },
    "vagrar": {
      "replik": "– Glöm det! Det är min kamera. Jag går nu.",
      "alternativ": [
        {
          "text": "Gå ut genom grinden och håll fast hans arm så att han inte kan gå.",
          "handling": "gripa_med_vald",
          "stamning": 3,
          "nasta": "gripen"
        },
        {
          "text": "Låt honom gå. Notera registreringsnumret och rapportera direkt.",
          "handling": "lata_ga",
          "nasta": "lamnar",
          "npc_beteende": "ga_till_start"
        }
      ]
    },
    "gripen": {
      "replik": "– Släpp mig! Du har ingen rätt att göra så här!\n\nKAMRATEN: – Jag täcker! Ska jag ropa upp AQ?",
      "slut": true
    },
    "lamnar": {
      "replik": "Mannen muttrar något och går tillbaka mot bilen.",
      "slut": true
    },
    "lamnar_lugn": {
      "replik": "– Okej. Ha en bra kväll då.\n\nMannen går lugnt tillbaka mot bilen.",
      "slut": true
    },
    "id_fraga": {
      "replik": "– Varför skulle jag det? Jag står ju på en skogsväg!",
      "alternativ": [
        {
          "text": "Förklara att den som uppehåller sig invid ett skyddsobjekt är skyldig att uppge det på begäran.",
          "handling": "upplysa_skyldighet",
          "stamning": -1,
          "nasta": "id_lamnat"
        },
        {
          "text": "”Gör som jag säger.”",
          "stamning": 2,
          "nasta": "vagrar_id"
        }
      ]
    },
    "id_lamnat": {
      "replik": "– Okej då… Johan Ek, född -85, bor i Granåsen. Nöjd?",
      "satt_fakta": {
        "id_lamnat": true
      },
      "alternativ": [
        {
          "text": "Anropa AQ, rapportera och begär order.",
          "handling": "rapportera_vaktchef",
          "nasta": "vaktchef"
        },
        {
          "text": "Uppmana honom att lämna platsen och sluta fotografera.",
          "handling": "avlagsna",
          "stamning": 1,
          "nasta": "lamnar_lugn",
          "npc_beteende": "ga_till_start"
        },
        {
          "text": "Anteckna uppgifterna och registreringsnumret, låt honom gå.",
          "handling": "dokumentera",
          "nasta": "lamnar_lugn",
          "npc_beteende": "ga_till_start"
        }
      ]
    },
    "vagrar_id": {
      "replik": "– Nej. Det ger jag inte ut till någon vakt.",
      "satt_fakta": {
        "vagrat_id": true
      },
      "alternativ": [
        {
          "text": "Avlägsna honom: beordra honom att lämna platsen direkt.",
          "handling": "avlagsna",
          "stamning": 1,
          "nasta": "lamnar",
          "npc_beteende": "ga_till_start"
        },
        {
          "text": "Omhänderta honom tillfälligt.",
          "handling": "tillfalligt_omhanderta",
          "stamning": 3,
          "satt_fakta": {
            "omhandertagande_genomfort": true
          },
          "nasta": "omhandertagen"
        },
        {
          "text": "Låt honom gå. Notera registreringsnumret och rapportera.",
          "handling": "lata_ga",
          "nasta": "lamnar",
          "npc_beteende": "ga_till_start"
        }
      ]
    },
    "omhandertagen": {
      "replik": "– Det här kommer ni att få ångra!\n\nMannen följer motvilligt med mot grinden. Kamraten täcker.",
      "slut": true
    }
  },
