  "lagestext": {
    "fore": "inga avvikelser vid grinden",
    "efter": "hantverkare från Ventservice vid grinden, ej föranmäld",
    "kontakt_arlig": "hantverkare från Ventservice har lämnat grinden, besöket var inte föranmält",
    "kontakt_oriktig": "person som uppgav sig komma från Ventservice har lämnat grinden, uppgifterna stämde inte"
  },
  "slutkrav": [
    {
      "handling": "rapportera_vaktchef",
      "lagrum": "Bevakningsinstruktion – passerkontroll",
      "text": "Besöket kontrollerades aldrig med CQ.",
      "diskutera": "Varför ska ett oanmält besök alltid kontrolleras med vaktchefen?"
    }
  ],
  "dialog": {
    "start": {
      "du": "Hej, vi är militära skyddsvakter. Vad gäller ditt ärende?",
      "replik": "HANTVERKAREN: – Tjena! Jonas från Ventservice. Vi ska byta filter i ventilationen i {objekt_bestamd}. Kan ni öppna bommen?",
      "alternativ": [
        {
          "text": "Be honom uppge namn, födelsetid och hemvist – och be att få se legitimation och arbetsorder.",
          "handling": "begara_identitet",
          "nasta": "leg_arlig",
          "nasta_variant": {
            "arlig": "leg_arlig",
            "oriktig": "leg_oriktig"
          }
        },
        {
          "text": "Anropa CQ och kontrollera om besöket är föranmält.",
          "handling": "rapportera_vaktchef",
          "nasta": "aq_kontroll"
        },
        {
          "text": "Öppna bommen och släpp in honom.",
          "handling": "slappa_in",
          "nasta": "inslappt"
        }
      ]
    },
    "leg_arlig": {
      "replik": "HANTVERKAREN: – Visst, här. Jonas Berg. Arbetsordern har chefen, men det är beställt, jag lovar.",
      "alternativ": [
        {
          "text": "Anropa CQ och kontrollera om besöket är föranmält.",
          "handling": "rapportera_vaktchef",
          "nasta": "aq_kontroll"
        },
        {
          "text": "Be att få titta i servicebilen.",
          "handling": "undersoka_fordon",
          "nasta": "fordon_arlig"
        },
        {
          "text": "Legitimationen stämmer – släpp in honom.",
          "handling": "slappa_in",
          "nasta": "inslappt"
        }
      ]
    },
    "fordon_arlig": {
      "replik": "HANTVERKAREN: – Kör hårt. Filter, verktyg och en termos. Inget konstigt.",
      "alternativ": [
        {
          "text": "Anropa CQ och kontrollera om besöket är föranmält.",
          "handling": "rapportera_vaktchef",
          "nasta": "aq_kontroll"
        },
        {
          "text": "Släpp in honom.",
          "handling": "slappa_in",
          "nasta": "inslappt"
        }
      ]
    },
    "leg_oriktig": {
      "replik": "HANTVERKAREN: – Här… Ja, det står Peter Ström. Det är min kollegas. Jag glömde min. Men jag heter Jonas, alltså.",
      "satt_fakta": {
        "oriktiga_uppgifter": true
      },
      "stamning": 3,
      "alternativ": [
        {
          "text": "Be att få undersöka servicebilen.",
          "handling": "undersoka_fordon",
          "nasta": "fordon_oriktig"
        },
        {
          "text": "Anropa CQ och kontrollera om besöket är föranmält.",
          "handling": "rapportera_vaktchef",
          "nasta": "aq_kontroll"
        },
        {
          "text": "Avvisa honom: han får inte komma in och ska lämna grinden.",
          "handling": "avvisa",
          "nasta": "avvisad",
          "npc_beteende": "ga_till_start"
        }
      ]
    },
    "fordon_oriktig": {
      "replik": "HANTVERKAREN: – Nej, nu får det vara nog. Ni har inget med min bil att göra.",
      "satt_fakta": {
        "vagrat_fordon": true
      },
      "stamning": 5,
      "alternativ": [
        {
          "text": "Avvisa honom med stöd av 12 §: han ska lämna grinden.",
          "handling": "avvisa",
          "nasta": "avvisad",
          "npc_beteende": "ga_till_start"
        },
        {
          "text": "Omhänderta honom tillfälligt.",
          "handling": "tillfalligt_omhanderta",
          "stamning": 2,
          "satt_fakta": {
            "omhandertagande_genomfort": true
          },
          "nasta": "omhandertagen"
        },
        {
          "text": "Anropa CQ och rapportera.",
          "handling": "rapportera_vaktchef",
          "nasta": "aq_kontroll"
        }
      ]
    },
    "aq_kontroll": {
      "replik": "DU (radio): ”CQ, CQ.” – CQ: ”CQ kom.”\nDU: ”Från Grindposten, hantverkare från Ventservice vid grinden, begär kontroll av behörighet, kom.”\nCQ: ”Inget besök föranmält. Släpp inte in. Slut kom.” – DU: ”Klart slut.”",
      "alternativ": [
        {
          "text": "Förklara att besöket inte är föranmält och att han inte får komma in.",
          "handling": "neka_tilltrade",
          "nasta": "nekad",
          "npc_beteende": "ga_till_start"
        },
        {
          "text": "Avvisa honom med stöd av 12 §.",
          "handling": "avvisa",
          "nasta": "avvisad",
          "npc_beteende": "ga_till_start"
        },
        {
          "text": "Släpp in honom ändå – han verkar schysst.",
          "handling": "slappa_in",
          "nasta": "inslappt"
        }
      ]
    },
    "nekad": {
      "replik": "HANTVERKAREN: – Typiskt. Jag ringer kontoret. Ha det.",
      "slut": true
    },
    "avvisad": {
      "replik": "HANTVERKAREN: – Okej, okej. Jag åker.",
      "slut": true
    },
    "omhandertagen": {
      "replik": "HANTVERKAREN: – Vad i… Det här är ju sjukt!\n\nKamraten tar fram radion.",
      "slut": true
    },
    "inslappt": {
      "replik": "Bommen går upp och servicebilen rullar in.\n\nKAMRATEN: – Stod han på passerlistan…?",
      "slut": true
    }
  },
