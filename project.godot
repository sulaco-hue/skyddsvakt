; Engine configuration file.
; Öppna mappen i Godot 4.3 eller senare.

config_version=5

[application]

config/name="Halt, militär skyddsvakt!"
config/description="Träningsspel för militära skyddsvakter: skyddslagen, nödvärn och radiotrafik i pixelstil."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0705882, 0.0941176, 0.133333, 1)
boot_splash/image="res://assets/gfx/startbild.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=false

[autoload]

Spel="*res://scripts/core/spel.gd"
Musik="*res://scripts/core/musik.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.07, 0.094, 0.133, 1)
